{
  "name": "adeuk-titans",
  "version": "0.1.0",
  "private": true,
  "description": "ADEUK: TITANS \u2014 a 2.5D cosmic pixel-art fighting game where colossal entities physically wear each other down.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "perf": "tsx tools/lead/perf.ts",
    "capture": "tsx tools/lead/capture.ts",
    "balance": "tsx tools/ai/balance.ts",
    "audio:verify": "tsx tools/ui/audio-verify.ts",
    "ui:sheet": "tsx tools/ui/sheet.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  }
}
